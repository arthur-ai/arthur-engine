###################################
## Minimum Required Configurations
###################################
# postgres database URL
postgresBYOEndpoint: ""
# GenAI Engine application ingress DNS URL (e.g. arthur-genai-engine.mydomain.com).
# This MUST be the same hostname as (1) the TLS/ACM certificate you terminate HTTPS with and
# (2) the DNS record you point at the ingress load balancer. If these three disagree, requests
# are served a 404 or a certificate error even though the pods are healthy. See the "ingress"
# block below and the README "Ingress and HTTPS" section.
genaiEngineIngressURL: ""
# Arthur Platform (Scope) frontend URL for this deployment (e.g. https://app.mydomain.arthur.ai)
scopeFeIngressURI: ""
# Provider of OpenAI LLMs (must be set to 'Azure' or 'OpenAI')
genaiEngineOpenAIProvider: "Azure"
# TLS verification for the LLM endpoint (e.g. an OpenAI-compatible LiteLLM proxy).
# Set to "false" to disable certificate verification (insecure; dev/test only).
genaiEngineOpenAIVerifySSL: "true"
# Optional URL serving a private CA / self-signed cert (PEM) for the LLM endpoint. When set,
# it is downloaded at container startup and trusted as the CA. Leave empty to use standard
# verification.
genaiEngineOpenAIPrivateCertDownloadURL: ""

###################################
## Additional Required Configurations For GPU Deployment
###################################
arthurGenaiEngineDeployment:
  annotations: {}
  labels: {}
  genaiEnginePodAnnotations: {}
  genaiEnginePodLabels: {}
  # Node selector for the GenAI Engine pod:
  #  - CPU deployment: leave as {}.
  #  - GPU deployment with managed node group + ASG: comment out the line below and uncomment the
  #    block to pin the DaemonSet to your GPU nodes (label the node group to match, e.g. capability=gpu).
  #  - GPU deployment with EKS Auto Mode / Karpenter: comment out the line below and uncomment the
  #    block (label your GPU NodePool to match). This nodeSelector is also what triggers Karpenter
  #    to provision a GPU node.
  genaiEnginePodNodeSelector: {}
  #genaiEnginePodNodeSelector:
  #  capability: gpu
  genaiEnginePodAffinity: {}
  # Tolerations for the GenAI Engine pod:
  #  - CPU deployment: leave as [].
  #  - GPU deployment with managed node group + ASG: leave as [] (per this chart's README the node
  #    group is only labeled, not tainted).
  #  - GPU deployment with EKS Auto Mode / Karpenter: comment out the line below and uncomment the
  #    block (per this chart's README the GPU NodePool is tainted nvidia.com/gpu=true:NoSchedule).
  genaiEnginePodTolerations: []
  #genaiEnginePodTolerations:
  #  - key: "nvidia.com/gpu"
  #    operator: "Exists"
  #    effect: "NoSchedule"
  auditLog:
    enabled: false
    mountPath: "/home/nonroot/app/audit_logs"
    # Size requested for the audit log PVC
    storageSize: "10Gi"
    # ReadWriteMany-capable storage class to back the audit log PVC (e.g. NFS, EFS, Azure Files)
    storageClassName: ""
    # (Optional) Group ID applied as the pod's fsGroup so the non-root container can write to the mounted PVC.
    # Required on platforms that mount volumes as root (e.g. OpenShift - use a GID from the namespace's allowed range).
    fsGroup: ""

# CPU deployment - Comment out the below 4 lines
gpuEnabled: false
genaiEngineDeploymentType: "deployment"
genaiEngineWorkers: 1
genaiEngineContainerImageLocation: "arthurplatform/genai-engine-cpu"

# GPU deployment with managed node group + ASG - Uncomment the below 4 lines
# (one GPU pod per node; the DaemonSet fills each node as the ASG scales the node group)
#gpuEnabled: true
#genaiEngineDeploymentType: "daemonset"
#genaiEngineWorkers: 2
#genaiEngineContainerImageLocation: "arthurplatform/genai-engine-gpu"

# GPU deployment with EKS Auto Mode / Karpenter - Uncomment the below 4 lines
# (Karpenter provisions GPU nodes only for unschedulable workload pods, not DaemonSets, so use a
#  Deployment; also set genaiEnginePodNodeSelector above to your GPU NodePool label)
#gpuEnabled: true
#genaiEngineDeploymentType: "deployment"
#genaiEngineWorkers: 2
#genaiEngineContainerImageLocation: "arthurplatform/genai-engine-gpu"

arthurGenaiEngineHPA:
  # - CPU deployment: true.
  # - GPU deployment with managed node group + ASG: false (HPA does not apply to a DaemonSet).
  # - GPU deployment with EKS Auto Mode / Karpenter: false (GPU node scaling is handled by Karpenter).
  enabled: true
  annotations: {}
  labels: {}
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
        - type: Percent
          value: 100
          periodSeconds: 15
    scaleUp:
      stabilizationWindowSeconds: 30
      policies:
        - type: Percent
          value: 100
          periodSeconds: 15
      selectPolicy: Max
  minReplicas: 2
  maxReplicas: 10
  targetCPUUtilizationPercentage: 50
  targetMemoryUtilizationPercentage: 80

###################################
## Advanced - General
###################################
# Name suffix for this Arthur stack resources (e.g. 'dev' or 'prod')
arthurResourceNameSuffix: ""
# Are credentials required to access the container repository?
containerRepositoryCredentialRequired: false

###################################
## Advanced - Database
###################################
# GenAI Engine database name
genaiEngineDBDatabaseName: "arthur_genai_engine"
# postgres database port
postgresBYOPort: 5432
# Postgres SSL certificate download URL (must be an HTTPS endpoint)
postgresSSLCertDownloadURL: "https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem"
# Postgres client connection pool max overflow
postgresClientConnectionPoolMaxOverflow: 15
# Postgres client connection pool size
postgresClientConnectionPoolSize: 5

###################################
## Advanced - Kubernetes Ingress
###################################
# Ingress controller + TLS termination. HTTPS is a prerequisite (see README "Ingress and
# HTTPS"); configure it here. Pick the option that matches how your cluster exposes services:
#
#   - Option A - nginx ingress controller (default): the controller must be installed
#     separately (it is NOT part of this chart). TLS is terminated at nginx using a Kubernetes
#     TLS secret referenced under `tls`.
#   - Option B - AWS ALB (EKS Auto Mode, or any cluster running the AWS Load Balancer
#     Controller): there is NO nginx controller on these clusters. Use the built-in `alb`
#     IngressClass and terminate TLS at the ALB with an ACM certificate via annotations.
#
# Whichever you pick, the HTTPS hostname must equal genaiEngineIngressURL (see note above).
ingress:
  # --- Option A: nginx (default) ---
  className: "nginx"
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
    # Uncomment to redirect HTTP->HTTPS once the `tls` block below is configured:
    # nginx.ingress.kubernetes.io/ssl-redirect: "true"
  # TLS termination at nginx. Create the secret first, then uncomment:
  #   kubectl -n <namespace> create secret tls genai-engine-tls --cert=tls.crt --key=tls.key
  # tls:
  #   - hosts:
  #       - arthur-genai-engine.mydomain.com   # must equal genaiEngineIngressURL
  #     secretName: genai-engine-tls
  #
  # --- Option B: AWS ALB (EKS Auto Mode / AWS Load Balancer Controller) ---
  # Replace the className + annotations above with the following. TLS is terminated at the ALB
  # using an ACM certificate whose domain equals genaiEngineIngressURL; do NOT set a `tls` block.
  # className: "alb"
  # annotations:
  #   alb.ingress.kubernetes.io/scheme: internet-facing
  #   alb.ingress.kubernetes.io/target-type: ip
  #   alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
  #   alb.ingress.kubernetes.io/ssl-redirect: "443"
  #   alb.ingress.kubernetes.io/certificate-arn: "arn:aws:acm:<region>:<account-id>:certificate/<cert-id>"
  #   alb.ingress.kubernetes.io/healthcheck-path: /health
  labels: {}

###################################
## Advanced - GenAI Engine
###################################
# GenAI Engine version
genaiEngineVersion: '2.1.725'
# Max number of tokens GenAI Engine can process against LLM for hallucination data checks
genaiEngineHallucinationCheckMaxTokenLimit: 3000
# Max number of tokens GenAI Engine can process against LLM for sensitive data checks
genaiEngineSensitiveDataCheckMaxTokenLimit: 6000
# Max number of tokens an inference can have for the toxicity rule to run. This is for managing validation latency.
genaiEngineToxicityCheckMaxTokenLimit: 8000
# Enable PII model v2
genaiEngineUsePIIModelV2: "true"
# Enable task rules cache
genaiEngineCacheTaskRulesCacheEnabled: true
# Task rules cache TTL in seconds
genaiEngineCacheTaskRulesCacheTTL: 60
# Set to enabled to add Transfer-Encoding: chunked header and strip Content-Length from all responses
transferEncodingMiddlewareEnabled: "enabled"
# Number of replicas of GenAI Engine pod running in k8s cluster (This is automatically overridden if the GenAI Engine HPA is enabled)
genaiEngineReplicaCount: 2
# CPU requests value for GenAI Engine
genaiEngineContainerCPURequests: "7"
# Memory requests value for GenAI Engine
genaiEngineContainerMemoryRequests: "16Gi"
# CPU limits value for GenAI Engine
genaiEngineContainerCPULimits: "8"
# Memory limits value for GenAI Engine
genaiEngineContainerMemoryLimits: "16Gi"
# Name of the service account used by the GenAI Engine pod (if no service account is specified, the pod will use its default behavior, which usually means that it uses the `default` k8s service account)
genaiEngineServiceAccount:
  create: false
  name: ""
# Modifiable properties of Arthur GenAI Engine service
arthurGenaiEngineService:
  annotations: {}
  labels: {}
# Allow the admin key general API access (Must be enabled for the Arthur Platform. Can be disabled for the guardrails-only standalone deployment.)
genaiEngineAllowAdminKeyGeneralAccess: "enabled"
# (Optional) Custom URL for the model repository (e.g. a private Hugging Face mirror). If not specified, the default Hugging Face endpoint will be used.
# modelRepositoryURL: ""
# (Optional) reCAPTCHA Enterprise — gates the public tenant signup endpoint. All three of project id, site key, and the API-key secret
# must be set for verification to run; otherwise the signup endpoint fails open. The site key must match the one baked into the UI build.
# recaptchaEnterpriseProjectId: ""
# recaptchaEnterpriseSiteKey: ""

###################################
## Advanced - Secrets name customization
###################################
# Name of the secret containing the credentials for the container repository holding the GenAI Engine image
# (expecting values for keys 'docker-server', 'docker-username', 'docker-password', 'docker-email')
imagePullSecretName: "arthur-repository-credentials"
# GenAI Engine secret Postgres name (expecting values for keys 'username' and 'password')
genaiEngineSecretPostgresName: "postgres-secret"
# GenAI Engine secret admin key name (expecting value for key 'key')
genaiEngineSecretAdminKeyName: "genai-engine-secret-admin-key"
# Name of the secret which stores the connection strings for Azure OpenAI GPT-3.5 model endpoints. Must be in form "DEPLOYMENT_NAME1::OPENAI_ENDPOINT1::SECRET_KEY1,DEPLOYMENT_NAME2::OPENAI_ENDPOINT2::SECRET_KEY2"). Many may be specified.
# (expecting value for key 'keys')
genaiEngineSecretOpenAIGPTModelNamesEndpointsKeysName: "genai-engine-secret-open-ai-gpt-model-names-endpoints-keys"
# GenAI Engine secret store key name (expecting value for key 'key' - should be a base64-encoded 32-byte Fernet key)
genaiEngineSecretStoreKeyName: "genai-engine-secret-store-key"
# (Optional) Name of the secret holding the reCAPTCHA Enterprise REST API key (expecting value for key 'key'). Leave unset to disable reCAPTCHA verification.
# genaiEngineSecretRecaptchaApiKeyName: "genai-engine-secret-recaptcha-api-key"

###################################
## Advanced - Model loading: online (Hugging Face) vs offline (PVC)
###################################
# Toggle how GenAI Engine gets its model binaries:
#   enabled: false (default) -> ONLINE. Models are downloaded from Hugging Face at startup
#                               (or from modelRepositoryURL if set). No PVC required.
#   enabled: true            -> OFFLINE. Mount a pre-populated PersistentVolumeClaim (e.g. the
#                               EFS-backed PVC from deployment/terraform/eks-efs-models) and load
#                               models from it with no network. The chart sets MODEL_STORAGE_PATH
#                               + HF_HUB_OFFLINE=1 and the engine skips the startup download.
modelPVC:
  enabled: false
  # Name of the PersistentVolumeClaim to mount (must already exist in this namespace)
  claimName: "arthur-models-pvc"
  # Path the volume is mounted at inside the container (also becomes MODEL_STORAGE_PATH)
  mountPath: "/home/nonroot/models-output"
  # Must be read-write: the HuggingFace loaders write .lock/cache files under the mount even in
  # offline mode, so a read-only mount fails with "[Errno 30] Read-only file system".
  readOnly: false

###################################
## Advanced - Health probes
###################################
# Startup + readiness probes on GET /health. The startup probe tolerates slow first-boot model
# loading (especially from an EFS-backed PVC); readiness gates the load balancer until workers
# serve, avoiding 502s during startup. Set enabled: false to disable both.
probes:
  enabled: true
  # Startup budget = startupPeriodSeconds * startupFailureThreshold (default ~10 min for cold load)
  startupPeriodSeconds: 10
  startupFailureThreshold: 60

###################################
## Advanced - GCP Service Account
###################################
gcpDiscoveryConfig:
  isEnabled: false
  # Google Cloud project ID for Vertex AI integration
  # googleCloudProject: ""
  # (Optional) Google Cloud region/location
  # googleCloudLocation: ""
  # (Optional) Name of the K8s secret containing the GCP service account JSON key
  # googleCredentialsSecretName: ""
