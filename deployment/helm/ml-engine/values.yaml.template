containerRepository:
  imageLocation: "arthurplatform"
  credentialsRequired: false
  imagePullSecretName: ""
resourceNameSuffix: ""
mlEngine:
  deployment:
    ###################################
    ## Minimum Required Configurations for when deployed with Arthur GenAI Engine
    ###################################
    # Full URL of the GenAI Engine ingress, INCLUDING the "https://" scheme.
    # This is the same host as genaiEngineIngressURL in the arthur-genai-engine chart, but note that
    # genaiEngineIngressURL is a bare hostname (no scheme) whereas this value MUST include "https://".
    # Example: "https://arthur-genai-engine.mydomain.com"
    genaiEngineInternalIngressHost: ""
    fetchRawDataEnabled: true
    genaiEngineMaxPageSize: 1500

    ###################################
    ## Advanced - General
    ###################################
    replicas: 1
    labels: {}
    annotations: {}
    mlEnginePodLabels: {}
    # Name of the service account used by the ML Engine pod (if no service account is specified, the pod will use its default behavior, which usually means that it uses the `default` k8s service account)
    mlEngineServiceAccount:
      create: false
      name: ""
    containerImageName: "ml-engine"
    containerImageVersion: "2.1.732"
    containerMemoryRequests: "16Gi"
    containerCPURequests: "7"
    containerMemoryLimits: "16Gi"
    containerCPULimits: "8"
    appPlaneUrl: "https://platform.arthur.ai"
    mlEnginePodNodeSelector: {}
    mlEnginePodAffinity: {}
    mlEnginePodTolerations: {}

    ###################################
    ## Advanced - Secrets name customization
    ###################################
    # ML Engine client secret name (expecting values for keys 'client_id' and 'client_secret')
    mlEngineClientSecretName: "ml-engine-client-secret"
    # GenAI Engine secret admin key name (expecting value for key 'key')
    genaiEngineInternalAPIKeySecretName: "genai-engine-secret-admin-key"

###################################
## Advanced - Autoscaling
###################################
# HorizontalPodAutoscaler for the ML Engine.
# NOTE: each replica requests ~16Gi RAM / 7-8 CPU, so maxReplicas multiplies that footprint
# (e.g. maxReplicas: 10 => up to ~160Gi / ~80 CPU). Requires a metrics-server in the cluster.
# Set enabled: false to pin a fixed replica count via mlEngine.deployment.replicas instead.
arthurMLEngineHPA:
  enabled: true
  annotations: {}
  labels: {}
  # Conservative scale-down / aggressive scale-up (mirrors the genai-engine chart).
  behavior:
    scaleDown:
      stabilizationWindowSeconds: 300
      policies:
        - type: Percent
          value: 100
          periodSeconds: 15
    scaleUp:
      stabilizationWindowSeconds: 30
      policies:
        - type: Percent
          value: 100
          periodSeconds: 15
      selectPolicy: Max
  minReplicas: 2
  maxReplicas: 10
  targetCPUUtilizationPercentage: 50
  targetMemoryUtilizationPercentage: 80
