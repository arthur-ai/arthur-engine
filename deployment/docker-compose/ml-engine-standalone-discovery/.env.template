# Secrets the discovery config references as ${NAME}. Uncomment and set only the ones
# your discovery.yaml uses: a variable left blank here is still set, as empty, and the
# engine refuses an empty secret at startup.
# SPLUNK_HEC_TOKEN=
# WEBHOOK_TOKEN=
# JAMF_CLIENT_ID=
# JAMF_CLIENT_SECRET=

# Only for a gcp_vertex source with no service_account_key: use the container's
# Application Default Credentials instead.
# ARTHUR_ENGINE_GCP_VERTEX_ALLOW_ADC=true
