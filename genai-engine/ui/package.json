{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "resolutions": {
    "@arizeai/openinference-semantic-conventions": "2.7.0",
    "pdfjs-dist": "6.2.108"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc -b --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "yarn type-check && yarn lint && yarn format:check",
    "preview": "vite preview",
    "generate-api": "yarn dlx swagger-typescript-api@13.0.16 -p ../staging.openapi.json -o src/lib/api-client --name api-client.ts --axios --clean-output --extract-request-params --extract-request-body --extract-response-body --extract-response-error --extract-enums --union-enums --add-readonly --sort-routes --sort-types",
    "generate-api:clean": "rm -rf src/lib/api-client && yarn generate-api"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "2.45.6",
    "@amplitude/experiment-js-client": "^1.21.1",
    "@amplitude/plugin-session-replay-browser": "^1.33.6",
    "@arizeai/openinference-semantic-conventions": "2.7.0",
    "@arthur/shared-components": "^3.23.3",
    "@base-ui/react": "1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@floating-ui/react": "^0.27.19",
    "@hugocxl/react-to-image": "^0.0.9",
    "@monaco-editor/react": "4.7.0",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/x-charts": "8.29.3",
    "@mui/x-date-pickers": "7.29.4",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-pacer": "0.23.0",
    "@tanstack/react-query": "5.102.1",
    "@tanstack/react-query-devtools": "5.102.1",
    "@tanstack/react-table": "8.21.3",
    "axios": "1.19.0",
    "dayjs": "1.11.23",
    "html-to-image": "^1.11.13",
    "material-react-table": "3.2.1",
    "mitt": "^3.0.1",
    "monaco-editor": "0.56.0",
    "motion": "13.1.1",
    "notistack": "3.0.2",
    "nuqs": "2.10.0",
    "ohash": "2.0.12",
    "papaparse": "5.6.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.3",
    "react-markdown": "10.1.0",
    "react-router": "^8.3.0",
    "react-use-measure": "2.1.7",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "usehooks-ts": "3.1.1",
    "uuid": "14.0.2",
    "yaml": "2.9.0",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.102.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "24.13.3",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "jsdom": "^30.0.0",
    "prettier": "3.9.6",
    "swagger-typescript-api": "^13.12.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "4.1.11"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.5"
  }
}
