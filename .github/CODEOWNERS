# Requires human review (any Arthur engineer)
#
# Any PR touching a path below needs approval from one member of
# @arthur-ai/arthur-engineers before it can merge. This only takes effect once
# "Require review from Code Owners" is enabled on the `dev` ruleset (feature
# PRs merge into `dev`; `main` only receives automated release PRs). GitHub
# reads this file from the PR's base branch.
#
# There is intentionally no "*" default owner: paths not listed here are NOT
# gated, so ordinary PRs are left to the automated reviewer.
#
# Patterns starting with "/" are anchored to the repo root. Later lines win,
# so a path with no owner at the bottom un-gates a file inside a gated dir.

# --- this file + ci/cd ---
# Covers CODEOWNERS itself, workflows, composite actions and CI scripts.
/.github/**                                                       @arthur-ai/arthur-engineers
/renovate.json                                                    @arthur-ai/arthur-engineers
# Claude hooks; these run inside the CI Claude workflows.
**/.claude/settings.json                                          @arthur-ai/arthur-engineers
# Run as Claude hooks by renovate-autofix.yml with protected-branch secrets.
/integrations/claude-code-observability/claude_code_tracer.py     @arthur-ai/arthur-engineers
# CVE suppressions applied to release vulnerability reports.
/security/vex/**                                                  @arthur-ai/arthur-engineers
# Build/codegen for the wheel the release workflow publishes to PyPI. The
# release job runs generate_openapi_client.sh from arthur-observability-sdk/,
# so openapitools.json there is the one that pins the generator it downloads.
/arthur-observability-sdk/scripts/build_sdk_wheel.sh              @arthur-ai/arthur-engineers
/arthur-observability-sdk/scripts/generate_openapi_client.sh      @arthur-ai/arthur-engineers
/arthur-observability-sdk/openapitools.json                       @arthur-ai/arthur-engineers
# Generates the genai_client shipped inside the ml-engine release image.
/ml-engine/scripts/openapitools.json                              @arthur-ai/arthur-engineers
# Release image build: sends GITLAB_UNIFY_FRONTEND_TOKEN to the registry
# configured here, and decides which env values are inlined into the bundle.
/genai-engine/ui/.yarnrc.yml                                      @arthur-ai/arthur-engineers
/genai-engine/ui/vite.config.ts                                   @arthur-ai/arthur-engineers

